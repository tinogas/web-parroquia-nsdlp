# Credenciales de la base de datos (cada entorno tiene las suyas)
config/database.php

# setup.php SÍ se versiona: la instalación empieza clonando el repositorio, así
# que el instalador tiene que venir dentro. Lo que no debe pasar es que se quede
# en el servidor después de usarlo; eso está advertido en el README, en el
# propio archivo y en docs/DESPLIEGUE.md.

# Archivos subidos desde el panel (conservar carpetas, ignorar contenido)
uploads/*
!uploads/.htaccess
!uploads/*/
uploads/*/**
!uploads/*/.gitkeep

# Respaldos de base de datos
backups/*.sql

# Hojas de cálculo de trabajo: la agenda parroquial que se transcribe a mano, la
# lista que levantó la pastoral de Proclamadores, y lo que sacan de ellas los
# scripts de herramientas/. Los scripts sí se versionan; los datos de origen y
# su extracción no —son datos personales, además: fechas de nacimiento—.
*.xlsx
agenda-2026.json
proclamadores.json

# El rol de turnos que la coordinación de MESC venía armando a mano, del que
# salió el diseño de la hoja imprimible (assets/css/turnos_imprimir.css lo cita
# como referencia). Se queda fuera del repositorio por lo mismo que las hojas de
# arriba y con más razón: este repositorio es público, y la imagen es un rol real
# con los nombres de los ministros. Ningún código lo carga; solo lo mencionan
# comentarios. Si hace falta enseñarlo, se comparte por fuera.
rol_ministros.jpeg

# Logs y caché
*.log
*.cache

# Variables de entorno
.env
.env.local

# Editores e IDEs
.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# Dependencias (el proyecto no usa Composer; la regla es preventiva)
vendor/
node_modules/

# Caché de los scripts de herramientas/
__pycache__/
